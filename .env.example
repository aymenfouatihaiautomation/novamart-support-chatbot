AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=your_key_here
AWS_SECRET_ACCESS_KEY=your_secret_here
BEDROCK_KNOWLEDGE_BASE_ID=your_kb_id_here
BEDROCK_MODEL_ARN=arn:aws:bedrock:eu-west-1::foundation-model/anthropic.claude-sonnet-4-5
ANTHROPIC_API_KEY=your_anthropic_key_here

# LangSmith tracing (optionnel)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_key_here
LANGCHAIN_PROJECT=novamart-support-chatbot
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# Redis (Upstash) — memoire conversationnelle persistante (optionnel, fallback en memoire sinon)
REDIS_URL=rediss://default:your_password_here@your-instance.upstash.io:6379

# SMTP (Gmail) — handoff vers un agent humain via /contact
SMTP_EMAIL=your_gmail@gmail.com
SMTP_PASSWORD=your_app_password_here
SUPPORT_EMAIL=your_gmail@gmail.com
